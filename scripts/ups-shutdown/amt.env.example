# amt.env — copy to amt.env next to the script, chmod 600, root-owned.
#
# NEVER commit the real file. Values come from the 1Password item "ESXi BIOS"
# (Homelab vault) — the AMT admin account, not an ESXi account.
#
# Only used when AMT_FALLBACK=1, and only for a host that failed to answer on 443
# within HOST_WAIT. The MS-01s have no BMC, so AMT is their only lights-out path.

AMT_USER=admin
AMT_PASS=CHANGEME
