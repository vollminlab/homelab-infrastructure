# ups-shutdown.env — copy to ups-shutdown.env next to the script, chmod 600, root-owned.
#
# NEVER commit the real file. It holds an ESXi credential in cleartext, which is
# unavoidable: the script runs unattended from NUT during a power event, so it
# cannot prompt, and 1Password is unreachable by then. File permissions are the
# control. Retrieve the value from 1Password item "ESXi Root" (Homelab vault).

ESXI_USER=root
ESXI_PASS=CHANGEME

# Hosts driven in parallel, "label=address". Each is contacted on its own API —
# vCenter is deliberately not in this list.
ESXI_HOSTS="esxi01=192.168.151.2 esxi02=192.168.151.3 esxi03=192.168.151.4"

# Seconds to let Tools-initiated guest shutdowns finish before forcing them.
GUEST_TIMEOUT=240

# Seconds to wait for a host to drop off the network after poweroff.
HOST_TIMEOUT=120

# Hard ceiling on the whole run. When it expires the NAS powers off no matter
# what is still running. Must stay well under the UPS runtime (~22 min at the
# current ~30% load), and well above the measured real duration.
TOTAL_DEADLINE=600
