# pushover.env — copy to pushover.env next to the script, chmod 600, root-owned.
#
# NEVER commit the real file. Values come from the 1Password item
# "Pushover API Token" (Homelab vault): `credential` is the application token,
# `userKey` is the user key.
#
# Pushover is used directly rather than via Alertmanager on purpose: a UPS
# preflight failure has to be reportable when the cluster hosting Alertmanager is
# precisely what is at risk.

PUSHOVER_TOKEN=CHANGEME
PUSHOVER_USER=CHANGEME
